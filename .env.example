# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is gitignored for a reason.
# See docs/INFRASTRUCTURE.md §5.

# --- Supabase: database, auth, file storage ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Must NEVER be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- AI provider ---
# No key here. As of the ai_provider_config migration (2026-08-07, founder
# request), provider/model/API key are set from /admin, stored in the
# database, and editable without a redeploy — see lib/ai/providerConfig.ts.
# lib/ai/provider.ts throws a clear error until that's configured.

# --- Payments: Razorpay. Blocked on KYC approval. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Rate limiting (docs/ADMIN.md §5) ---
RATE_LIMIT_EXTRACTIONS_PER_DAY=5
# TASK-021: optimization fires and creates a package before payment (see
# docs/USER_FLOW.md screens 07-09) — not payment-gated, so it needs its own cap.
RATE_LIMIT_OPTIMIZATIONS_PER_DAY=20
# TASK-051: caps promo-code redemption ATTEMPTS (not just successes) — a code
# is a guessable string, so this guards against brute-forcing one.
RATE_LIMIT_PROMO_REDEMPTIONS_PER_DAY=10
# TASK-048: anonymous (no-login) rate limiting, keyed by IP hash. Convention:
# RATE_LIMIT_ANON_<ACTION>_PER_DAY (action upper-cased), default 3/day if
# unset. No action is wired to a route yet — TASK-049 (ATS scanner) will add
# its own action string and this var when it's built. See lib/anonymousRateLimit.ts.

# --- AI cost estimation (lib/ai/provider.ts, TASK-039) ---
# Sourced from Anthropic's published claude-sonnet-5 pricing; see the comment
# in provider.ts for the reasoning and date this was last checked.
AI_INR_PER_1K_INPUT=
AI_INR_PER_1K_OUTPUT=
