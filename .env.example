# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is gitignored for a reason.
# Names only here; every value is set per environment (Vercel project settings
# for production and preview). See docs/SAAS_RELEASE_CHECKLIST.md.

# --- Supabase: database, auth, file storage ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Must NEVER be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- AI provider ---
# No key here. Provider/model/API key are set from /admin, stored in the
# database, and editable without a redeploy — see lib/ai/providerConfig.ts.
# lib/ai/provider.ts throws a clear error until that's configured.
# Optional: longest one provider attempt may wait (ms). Default 150000.
AI_STALL_TIMEOUT_MS=

# --- Payments: Razorpay. Blocked on KYC approval. Not live. ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scheduled jobs (2026-09-15, audit H07) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/retention.
# Without it the nightly retention clean-up refuses to run (it fails closed).
# Use a long random value; never reuse another secret.
CRON_SECRET=

# --- Daily AI allowances per user (lib/rateLimit.ts) ---
# Code defaults apply when unset; /admin/services overrides any of them without
# a deploy. These defaults are ABUSE CEILINGS, not a commercial free plan — the
# free allowance is a founder decision (docs/SAAS_RELEASE_CHECKLIST.md).
RATE_LIMIT_EXTRACTIONS_PER_DAY=5
RATE_LIMIT_OPTIMIZATIONS_PER_DAY=20
RATE_LIMIT_PROMO_REDEMPTIONS_PER_DAY=10
# Added 2026-09-15 (audit H03): these services had no limit at all before.
RATE_LIMIT_JOB_DESCRIPTIONS_PER_DAY=30
RATE_LIMIT_COVER_LETTERS_PER_DAY=20
RATE_LIMIT_INTERVIEW_QA_PER_DAY=10
RATE_LIMIT_MOCK_INTERVIEWS_PER_DAY=10
RATE_LIMIT_MOCK_ANSWERS_PER_DAY=150
RATE_LIMIT_MOCK_REPORTS_PER_DAY=10
# Anonymous (no-login) limits, keyed by salted IP hash:
# RATE_LIMIT_ANON_<ACTION>_PER_DAY (action upper-cased), default 3/day if unset.
# See lib/anonymousRateLimit.ts.

# --- AI cost estimation (lib/ai/provider.ts) ---
AI_INR_PER_1K_INPUT=
AI_INR_PER_1K_OUTPUT=
